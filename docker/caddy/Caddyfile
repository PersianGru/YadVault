# HTTPS on the LAN with Caddy, turned on by docker-compose.https.yml (docs/https.md). HTTPS_MODE
# in .env chooses where the certificate comes from:
#   local            Caddy's own certificate authority (the default). Works for IP addresses and
#                    local names without internet access. Every device trusts it once: download it
#                    from Settings → HTTPS or https://<server>/yadvault-ca.crt.
#   letsencrypt      Let's Encrypt through the TLS-ALPN challenge: CADDY_DOMAIN is a public name
#                    that points at this server, and port 443 is reachable from the internet.
#   letsencrypt-dns  Let's Encrypt through the DNS challenge: the server stays on the LAN. Needs a
#                    domain at a DNS provider with an API (DNS_PROVIDER, DNS_API_TOKEN); the image
#                    is then built with that provider's module (docker/caddy/Dockerfile).
# Inside the container Caddy listens on 443 alone; HTTPS_PORT is the host port it is published on.
# Nothing listens for plain HTTP: a plain http:// request on the HTTPS port is redirected to
# https:// on the same port, and the certificate download is on the HTTPS site. docker/caddy/run.sh
# starts Caddy, sets the certificate lifetime (CERT_LIFETIME, changeable in Settings → HTTPS) and
# makes a new certificate authority when Settings asks for one.
{
	admin off
	# no plain-HTTP server for redirects (there is no plain-HTTP port); clients without SNI (an IP
	# address in the browser) get the certificate of CADDY_DEFAULT_SNI
	auto_https disable_redirects
	default_sni {$CADDY_DEFAULT_SNI:archive.local}
	# devices install the local CA themselves; the container's own trust store is not touched
	skip_install_trust
	pki {
		ca local {
			# the intermediate outlives the server certificates (run.sh keeps it at least 4 times as long)
			intermediate_lifetime {$CA_INTERMEDIATE_LIFETIME:168h}
		}
	}
	servers :443 {
		# a plain http:// request on the HTTPS port is redirected to https:// on the same port
		listener_wrappers {
			http_redirect
			tls
		}
		# no HTTP/3: its UDP port is not published
		protocols h1 h2
	}
}

# HSTS makes browsers use HTTPS for every port of the name, so turn it off (HSTS=off) when other
# plain-HTTP services share the server's name. Browsers ignore it for IP addresses.
(hsts_on) {
	header Strict-Transport-Security "max-age=31536000"
}

(hsts_off) {
}

# The local authority's server certificates are short-lived and renewed by Caddy on its own;
# CERT_LIFETIME (or Settings → HTTPS) chooses how long each one lasts.
(tls_local) {
	tls {
		issuer internal {
			lifetime {$CERT_LIFETIME:12h}
		}
	}
}

# Without a plain-HTTP port only the TLS-ALPN challenge (port 443) can prove the name.
(tls_letsencrypt) {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
}

(tls_letsencrypt-dns) {
	tls {
		issuer acme {
			dns {$DNS_PROVIDER} {$DNS_API_TOKEN}
			resolvers {$DNS_RESOLVERS:1.1.1.1 9.9.9.9}
		}
	}
}

# The root certificate of the local CA, for devices to trust. Only the certificate is served,
# never its key; with Let's Encrypt there is nothing to install.
(ca_local) {
	handle /yadvault-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=\"yadvault-ca.crt\""
		header Cache-Control no-store
		file_server
	}
}

(ca_letsencrypt) {
}

(ca_letsencrypt-dns) {
}

{$CADDY_DOMAIN:archive.local} {
	import tls_{$HTTPS_MODE:local}
	encode zstd gzip
	import hsts_{$HSTS:on}
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	import ca_{$HTTPS_MODE:local}
	handle {
		reverse_proxy app:8000 {
			flush_interval -1
		}
	}
}
