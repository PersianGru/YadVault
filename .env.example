# YadVault: configuration for `docker compose up -d`.
# Copy this file to .env and fill in the two passwords. .env is gitignored and never published.
# Lines starting with YADVAULT_ also work for a bare (non-Docker) install of the backend.

# ------------------------------------------------------------------ required
# Password of the database superuser the app uses (any long random string).
POSTGRES_PASSWORD=
# Password of the read-only database role used by the AI tools (Ask, MCP). Any other random string.
YADVAULT_RO_PASSWORD=

# The first-run setup asks for a one-time code, printed in the app's log at start
# (`docker compose logs app`) until the first account exists. Set one here to choose it yourself.
# YADVAULT_SETUP_CODE=

# Stored secrets (the LLM gateway's API key, single sign-on client secrets) are sealed in the
# database with a key file the app creates in its data volume. To keep the key out of the server's
# files and backups instead, set it here (docs/encryption.md); `docker compose run --rm app yadvault
# secrets new-key` prints one. Keep a copy: without it those secrets must be entered again.
# YADVAULT_SECRET_KEY=

# ------------------------------------------------------------------ license (optional)
# Without a key YadVault runs as the free version (docs/licensing.md). A YadVault Pro key goes into
# Settings → License, or here, where it wins over Settings and cannot be changed in the browser:
# YADVAULT_LICENSE_KEY=
# Or a file that holds the key, by its path inside the containers (a Docker secret, for example):
# YADVAULT_LICENSE_FILE=/run/secrets/yadvault_license

# ------------------------------------------------------------------ network
# Address the published ports bind to. 0.0.0.0 = every interface of the host, which on a home
# server means the LAN; set your LAN address (e.g. 192.168.1.10) to be explicit, or 127.0.0.1 to
# keep it on this machine only. Never expose the ports to the internet; limit them to your LAN with
# a firewall rule (see docs/operations.md).
BIND_ADDRESS=0.0.0.0
PORT=8000
OPEN_WEBUI_PORT=3000

# ------------------------------------------------------------------ HTTPS (optional, docs/https.md)
# Turn it on by adding docker-compose.https.yml to COMPOSE_FILE (below): Caddy serves the archive on
# ports 443 and 80, and port 8000 closes. HTTPS_MODE chooses the certificate:
#   local            Caddy's own certificate authority; every device installs it once from
#                    Settings → HTTPS or http://<server>/yadvault-ca.crt (default)
#   letsencrypt-dns  Let's Encrypt through your DNS provider's API; the server stays on the LAN
#   letsencrypt      Let's Encrypt through the HTTP challenge; needs ports 80/443 open to the internet
HTTPS_MODE=local
# Host ports of Caddy (default 443 and 80). When other services already use them, for example
# HTTPS_PORT=8000 and HTTP_PORT=8001; HTTP_PORT only redirects and serves the CA certificate. With
# other plain-HTTP services on the same server name, also set HSTS=off.
# HTTPS_PORT=443
# HTTP_PORT=80
# HSTS=on
# The address you open in the browser: this server's IP address or a name. Several, comma-separated:
# then set CADDY_DEFAULT_SNI to the IP address (what a browser gets when it connects by IP).
CADDY_DOMAIN=archive.local
# CADDY_DEFAULT_SNI=192.168.1.10
# letsencrypt-dns only: a caddy-dns module that takes one API token (cloudflare, duckdns,
# digitalocean, hetzner, ...), the token, and the resolvers that confirm the DNS record.
# DNS_PROVIDER=cloudflare
# DNS_API_TOKEN=
# DNS_RESOLVERS=1.1.1.1 9.9.9.9
# Behind a reverse proxy of your own instead of Caddy: PROXY_HEADERS=true and FORWARDED_ALLOW_IPS set
# to that proxy's address only (never * while port 8000 is reachable: anyone could then pick the
# address the login limits count).
# PROXY_HEADERS=true
# FORWARDED_ALLOW_IPS=192.168.1.20

# ------------------------------------------------------------------ LLM gateway (optional)
# The Ask page sends questions to a model through your own LLM gateway: any OpenAI-compatible
# API. The address is its API root: LiteLLM http://<host>:4000/v1, Ollama http://<host>:11434/v1
# (with the `llm` profile: http://ollama:11434/v1), Open WebUI http://<host>:3000/api. An address
# without a path gets /v1. Leave empty to set it up later in Settings. (The older OPEN_WEBUI_URL,
# OPEN_WEBUI_API_KEY and OPEN_WEBUI_MODEL names still work.)
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=

# ------------------------------------------------------------------ semantic search
# Search by meaning, in any language. Where the vectors come from (also in Settings → Semantic
# search, which wins once saved):
#   local   = the embeddings service on this server (the `embeddings` profile below)
#   gateway = an embedding model of your LLM gateway (LiteLLM with OpenAI, Ollama, ...)
#   off     = keyword search only
EMBEDDINGS_PROVIDER=local
# For gateway: the model's name at the gateway, and optionally fewer dimensions (OpenAI
# text-embedding-3 can shorten its vectors; 0 = the model's size).
# EMBEDDINGS_GATEWAY_MODEL=text-embedding-3-small
# EMBEDDINGS_DIMENSIONS=0

# Profiles started by `docker compose up -d`, comma-separated (for example embeddings,avatars).
# Leave out `embeddings` when the gateway provides the vectors or semantic search is off.
COMPOSE_PROFILES=embeddings
# Override files, separated by colons: docker-compose.gateway.yml gives the worker a route to the
# LLM gateway (EMBEDDINGS_PROVIDER=gateway); docker-compose.https.yml adds HTTPS with Caddy.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gateway.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# docker-compose.watch.yml mounts a host folder as the watch folder (the unfollower tracker):
# COMPOSE_FILE=docker-compose.yml:docker-compose.watch.yml
# WATCH_DIR=./watch
# docker-compose.backups.yml puts the backups made in Settings on a host folder (another disk):
# COMPOSE_FILE=docker-compose.yml:docker-compose.backups.yml
# BACKUP_DIR=./backups

# The local embeddings service runs one model, downloaded once into the hfcache volume. All of
# these handle text in any of about 100 languages; RAM is for the service, speed is windows per
# second on 12 CPU cores (divide by 6 for 2 cores):
#   intfloat/multilingual-e5-small    384 dimensions, about 1 GB RAM, 150/s   small servers (default)
#   intfloat/multilingual-e5-base     768 dimensions, about 2 GB RAM,  60/s   more accurate, CPU is fine
#   BAAI/bge-m3                      1024 dimensions, about 4 GB RAM,  20/s   best quality, long texts; GPU
#   Qwen/Qwen3-Embedding-0.6B        1024 dimensions, about 3 GB RAM,  slow   top quality for its size; GPU
# One language only: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions, tiny; see its model card). Changing the model
# needs a rebuild of the index (Settings → Semantic search). cpu works everywhere; cuda needs
# docker-compose.gpu.yml and the NVIDIA container toolkit.
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
EMBEDDINGS_DEVICE=cpu
EMBEDDINGS_BATCH=32
# Gated models (google/embeddinggemma-300m) need a Hugging Face token for the one download.
# HF_TOKEN=

# ------------------------------------------------------------------ AI tool switches
# Off by default: the model only reads. ENABLE_ANNOTATIONS lets it add notes and tags;
# ENABLE_SQL_TOOL allows one read-only SELECT over the v_* views per call.
ENABLE_ANNOTATIONS=false
ENABLE_SQL_TOOL=false

# ------------------------------------------------------------------ public profiles (optional add-on)
# The fetcher (profile `avatars`) is the only service that connects to Instagram, never with a
# login. Off by default; read the warning in Settings → Public profiles before enabling it there.
# To run it: add `avatars` to COMPOSE_PROFILES above, point the app at the service, then
# `docker compose up -d` (the steps are in docs/operations.md):
# AVATAR_FETCHER_URL=http://avatar-fetcher:8002
AVATAR_FETCH_PACE_SECONDS=15
# MEDIA_PACE_SECONDS=0.5
ENABLE_AVATAR_FETCH=false

# ------------------------------------------------------------------ resources
# Memory limits per container (Docker units). Raise WORKER_MEMORY_LIMIT for very large imports.
DB_MEMORY_LIMIT=3g
DB_SHARED_BUFFERS=512MB
DB_MAINTENANCE_WORK_MEM=512MB
APP_MEMORY_LIMIT=2g
WORKER_MEMORY_LIMIT=4g
# 3g fits multilingual-e5-small and -base; use 6g for bge-m3 or Qwen3-Embedding.
EMBEDDINGS_MEMORY_LIMIT=3g

# ------------------------------------------------------------------ logs and images
# json = one JSON object per line (never message content); text for a console.
LOG_FORMAT=json
LOG_LEVEL=info
# The release of YadVault to run: the images of this version. Change it when you update.
YADVAULT_VERSION=0.2.0
